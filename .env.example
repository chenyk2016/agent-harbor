# Copy to .env and enter credentials that you are authorized to use.
# Inside Docker, host.docker.internal reaches the host-side gateway.
AH_GATEWAY_URL=http://host.docker.internal:8080
AH_GATEWAY_TOKEN=replace-with-your-token
AH_MODEL=claude-sonnet-4-6
AH_IMAGE=agent-harbor:0.6.3
AH_DATA_DIR=var/service-sessions

# Optional backend for conversation, MCP probes, analysis, and build execution. See infra/opensandbox/README.md.
# AH_RESIDENT_BACKEND=docker
# AH_OPENSANDBOX_RUNNER_ORIGIN=http://127.0.0.1:8083
# AH_OPENSANDBOX_RUNNER_KEY=<private-manager-key>

# PostgreSQL control plane. The service does not create tables at startup:
# run `npm run db:migrate` once, then start the service.
# AH_DATABASE_URL=postgres://agent_harbor:password@127.0.0.1:5432/agent_harbor
# AH_DATABASE_POOL_MAX=10

# Administrator login key: keep it in the environment file loaded by the service.
# Required for the first managed init; restart the service after changing it.
# Set AH_ADMIN_USERS to a single account when using this key.
# AH_ADMIN_USERS=operator
# AH_BOOTSTRAP_ADMIN_KEY=<random-32-to-128-character-key>
# Separate client credential: npm run access-key -- developer
AH_SERVICE_URL=http://127.0.0.1:4318
AH_SERVICE_TOKEN=replace-with-generated-access-key

# V6: fixed external origin when using HTTPS reverse proxy (no trailing slash).
# AH_PUBLIC_ORIGIN=https://harbor.example.com
# OIDC confidential web client; redirect: PUBLIC_ORIGIN/api/auth/oidc/callback
# Provider must support client_secret_post and RS256/JWKS ID tokens.
# AH_OIDC_ISSUER=https://identity.example.com
# AH_OIDC_CLIENT_ID=your-client-id
# AH_OIDC_CLIENT_SECRET=your-client-secret
# Optional Workbench email/password. Use a private secret (at least 32 characters).
# AH_WORKBENCH_AUTH_SECRET=
# Public signup auto-enables with HTTPS, Workbench login and the managed wallet gateway, granting ¥10 per account.
# AH_WORKBENCH_REGISTRATION=false
# AH_KEY_LOGIN=false
# Explicit internal user IDs, comma-separated; first login is never made admin.
# AH_ADMIN_USERS=developer

# Skill准备使用的运行镜像；会话会固定镜像ID，已有会话继续原来的环境。
# 先构建主镜像，再构建infra/Dockerfile.skills，详见docs/skills.md。
AH_SKILL_IMAGE=agent-harbor:0.6.0
# 可选：服务下载公开依赖的可信代理。安装容器始终断网。
# AH_PACKAGE_PROXY=http://127.0.0.1:7890

# 原生MCP无需额外网关端口。本地stdio需0.6.2镜像，见docs/mcp.md。
# 所有远程MCP必须由管理员批准精确origin（含公网），默认不批准任何目标。
# AH_MCP_ALLOWED_ORIGINS=https://mcp.example.com,http://127.0.0.1:9000
# 可选管理员本地MCP固定命令模板；默认提供镜像内离线文本工具。
# AH_MCP_TEMPLATES_FILE=var/mcp-templates.json

# App builder auto-enables with the required settings and reachable Caddy and application database.
# AH_APPLICATIONS_ENABLED=0
# AH_APP_PUBLIC_ORIGIN=https://harbor.example.com
# AH_APP_CADDY_ADMIN=http://127.0.0.1:2019
# AH_APP_CREATOR_IDS=developer
# Dedicated app-data cluster admin; never given to generated apps.
# AH_APP_DATABASE_ADMIN_URL=postgres://app_admin:replace-me@127.0.0.1:5432/postgres
# If apps run in local Docker but PostgreSQL is published on the host:
# AH_APP_DATABASE_HOST=host.docker.internal
# AH_APP_EDGE_UPSTREAM_HOST=127.0.0.1
# AH_APP_DATA_DIR=var/service-sessions/.applications
# Optional build-only dependency download proxy, reachable inside Docker.
# AH_APP_BUILD_PROXY=http://host.docker.internal:7890

# Visitor login auto-enables when its settings are complete. New apps still choose their own login policy.
# AH_APP_AUTH_ENABLED=0
# AH_APP_AUTH_ORIGIN=https://auth.example.com
# AH_APP_AUTH_DOMAIN=apps.example.net
# Optional same-site HTTPS workbench. See the embedded preview setup in the visitor auth spec.
# AH_APP_AUTH_WORKBENCH_ORIGIN=https://studio.example.net
# Optional separate same-site HTTPS origin for email login inside the workbench preview.
# AH_APP_AUTH_EMBEDDED_ORIGIN=https://preview-auth.example.net
# AH_APP_AUTH_POCKETBASE=http://127.0.0.1:8090
# AH_APP_AUTH_POCKETBASE_TOKEN=<private-PocketBase-superuser-token>
# Required together only when a deployment declares Google login.
# AH_APP_AUTH_GOOGLE_ID=<Google-Web-OAuth-client-id>
# AH_APP_AUTH_GOOGLE_SECRET=<private-Google-OAuth-client-secret>
# Optional Better Auth for newly provisioned visitor scopes. Existing scopes keep their backend.
# AH_APP_AUTH_BACKEND=better_auth
# AH_APP_AUTH_BETTER_SECRET=<private-random-secret-at-least-32-characters>
# Distinct Google Web clients with redirect: AUTH_ORIGIN/__harbor/visitor/better-auth/callback/google
# AH_APP_AUTH_BETTER_GOOGLE_PREVIEW_ID=
# AH_APP_AUTH_BETTER_GOOGLE_PREVIEW_SECRET=
# AH_APP_AUTH_BETTER_GOOGLE_PRODUCTION_ID=
# AH_APP_AUTH_BETTER_GOOGLE_PRODUCTION_SECRET=
# AH_APP_AUTH_EDGE_DIAL=127.0.0.1:4318
# AH_APP_AUTH_EDGE_TOKEN=<random-base64url-at-least-32-characters>
# AH_APP_AUTH_SIGNING_KEY=<base64-PKCS8-DER-Ed25519-private-key>
# App preview and production runtime. Full OpenSandbox needs the manager's --application-root.
# AH_APP_RUNTIME_BACKEND=opensandbox
# These override the Runner origin/key in full mode. The app ID is for the earlier private preview pilot.
# AH_APP_OPENSANDBOX_ORIGIN=http://127.0.0.1:8081
# AH_APP_OPENSANDBOX_API_KEY=<private-opensandbox-api-key>
# AH_APP_OPENSANDBOX_PREVIEW_IDS=


# Application observations are provisioned by db:migrate when apps are enabled.
# Existing app installations can run npm run observability:migrate.
# AH_OBSERVATION_ENABLED=0
# Analysis auto-enables with observations and the managed wallet proxy.
# AH_APP_ANALYSIS_ENABLED=0
# Optional operator-approved business columns per application UUID and environment.
# Without a grant, business records expose only id and system timestamps to the model.
# AH_APP_ANALYSIS_TABLE_FIELDS={"00000000-0000-4000-8000-000000000001":{"preview":{"signups":["status"]}}}

# AH_OBSERVATION_DATABASE_URL=postgres://observation_user:replace-me@127.0.0.1:5432/harbor_observations
# npm run observability:migrate
# Internal collector only; configure firewall/Docker reachability before changing bind host.
# AH_OBSERVATION_PORT=4324
# AH_OBSERVATION_BIND_HOST=127.0.0.1
# AH_OBSERVATION_COLLECTOR_URL=http://host.docker.internal:4324
# Optional sanitized Caddy JSON access log, readable by the Harbor host process.
# See infra/app-observation.Caddyfile. Do not point to unfiltered sensitive logs.
# AH_OBSERVATION_EDGE_LOG=/var/log/caddy/application-access.json

# The managed LiteLLM gateway auto-enables with its URL and credential settings.
# AH_LLM_ENABLED=false
# AH_LITELLM_MANAGEMENT_URL=http://127.0.0.1:4320
# AH_LITELLM_INFERENCE_URL=http://host.docker.internal:4320
# AH_LITELLM_MASTER_KEY=replace-with-private-management-key
# AH_LITELLM_SALT_KEY=replace-with-persistent-encryption-key
# AH_LITELLM_DATABASE_URL=postgres://litellm:password@host.docker.internal:5432/litellm
# AH_LLM_DEFAULT_DEPLOYMENT_ID=<deployment-id-created-in-Harbor>
# Operator policy: user RPM, supplier USD rates and model request timeouts.
# No TPM/concurrency limit or automatic budget reset is imposed by this policy.
# AH_LLM_POLICY_FILE=infra/llm-policy.json
# Optional per-environment credential budget, renewed when a new credential is issued.
# AH_LLM_SESSION_BUDGET_USD=5

# Optional Langfuse Cloud: all three values enable tracing; all empty disables it.
# Same private values must be loaded into Harbor and the LiteLLM Compose environment.
# No separate enabled flag. Configuration changes require restart/recreate.
# AH_LANGFUSE_HOST=https://jp.cloud.langfuse.com
# AH_LANGFUSE_PUBLIC_KEY=replace-with-project-public-key
# AH_LANGFUSE_SECRET_KEY=replace-with-project-secret-key
# Optional content scope. Default metadata; redacted adds model and supported tool I/O.
# AH_LANGFUSE_CONTENT_MODE=metadata
# Optional routing: Harbor exporter respects HTTPS_PROXY/NO_PROXY.
# AH_LANGFUSE_CONTAINER_PROXY=http://host.docker.internal:7890

# RMB wallet billing. The Runner gets a Harbor-only key; real LiteLLM keys stay on the host.
# With an edge on 4318 and Node on 4319, point directly at the Node listener.
# AH_WALLET_ENABLED=false
# AH_WALLET_INFERENCE_URL=http://host.docker.internal:4319/inference

# 执行限额：0表示不设平台总时限/轮数/SDK估算费用上限；真实钱包仍生效。
AH_TASK_TIMEOUT_MS=0
AH_MAX_TURNS=0
AH_MAX_BUDGET_USD=0
