{
  "name": "agent-harbor",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run policy && tsc && npm run build --workspace @agent-harbor/web && node scripts/copy-service-assets.mjs",
    "check": "tsc --noEmit && npm run check --workspace @agent-harbor/web",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "cli": "node --env-file-if-exists=.env dist/src/clients/cli/main.js",
    "verify:docker": "npm run build && node dist/tests/docker-verification.js",
    "policy": "node infra/generate-policy.mjs",
    "verify:layout": "npm run build && node dist/tests/directory-verification.js",
    "verify:native": "npm run build && node tests/native-lifecycle-verification.mjs",
    "verify:persistent": "npm run build && node tests/persistent-verification.mjs",
    "verify:chat": "npm run build && node tests/chat-verification.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "release:source": "node scripts/export-source.mjs",
    "verify:streaming": "npm run build && node tests/streaming-verification.mjs",
    "verify:resident": "npm run build && node tests/resident-verification.mjs",
    "cli:local": "node --env-file-if-exists=.env dist/src/clients/cli/local.js",
    "server": "node --env-file-if-exists=.env dist/src/service/server.js",
    "db:migrate": "node --env-file-if-exists=.env dist/src/service/db/migrate.js",
    "db:import": "node --env-file-if-exists=.env dist/src/service/db/import-sqlite.js",
    "access-key": "node --env-file-if-exists=.env dist/src/service/create-access-key.js",
    "verify:service": "npm run build && node tests/service-verification.mjs",
    "preview:web": "npm run build && node tests/web-preview.mjs",
    "verify:web:gateway": "npm run build && node --env-file-if-exists=.env tests/web-gateway-verification.mjs",
    "verify:files": "npm run build && node tests/files-verification.mjs",
    "verify:files:gateway": "npm run build && node --env-file-if-exists=.env tests/files-verification.mjs --real",
    "admin": "node --env-file-if-exists=.env dist/src/clients/cli/admin.js",
    "dev:web": "npm run dev --workspace @agent-harbor/web",
    "build:web": "npm run build --workspace @agent-harbor/web",
    "verify:skills": "npm run build && node tests/skills-native-verification.mjs",
    "verify:skills:dependencies": "npm run build && node tests/skills-builder-verification.mjs",
    "skill:builtin": "node --env-file-if-exists=.env dist/src/service/skills/install-builtin.js",
    "expert:builtin": "node --env-file-if-exists=.env dist/src/service/experts/install-builtin.js",
    "verify:dependencies": "npm run build && node tests/dependency-runtime-verification.mjs",
    "verify:workbuddy": "npm run build && node tests/workbuddy-native-verification.mjs",
    "verify:mcp": "npm run build && node --env-file-if-exists=.env tests/mcp-native-verification.mjs",
    "verify:applications": "npm run build && node tests/applications-verification.mjs",
    "verify:applications:native": "npm run build && node tests/applications-native-verification.mjs",
    "observability:migrate": "npm run build && node --env-file-if-exists=.env dist/src/service/observability/migrate.js",
    "verify:application-analysis": "npm run build && node tests/application-analysis-runner-verification.mjs && node tests/application-analysis-verification.mjs && node tests/application-analysis-privacy-verification.mjs",
    "verify:observability": "npm run build && node tests/observability-verification.mjs",
    "verify:llm": "npm run build && node tests/llm-verification.mjs",
    "harbor": "node dist/src/clients/ops/main.js"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.2.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "kysely": "0.29.8",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "undici": "8.12.3",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "description": "Isolated Agent sessions for a multi-user Agent service.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11"
  },
  "files": [
    "src/",
    "infra/",
    "tests/",
    "examples/",
    "docs/",
    "scripts/",
    "LICENSES/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "tsconfig.json",
    ".env.example",
    "apps/web/",
    "templates/",
    "migrations/"
  ],
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "express": {
      "body-parser": "2.4.0"
    },
    "@anthropic-ai/sandbox-runtime": {
      "zod": "$zod"
    }
  }
}
