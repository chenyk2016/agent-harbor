{
  "formatVersion": 2,
  "template": "react-node-v1",
  "analytics": {
    "schemaVersion": 1,
    "events": {
      "signup_started": {
        "version": 1,
        "source": "browser",
        "properties": {}
      },
      "signup_submit_attempted": {
        "version": 1,
        "source": "browser",
        "properties": {}
      },
      "signup_succeeded": {
        "version": 1,
        "source": "server",
        "properties": {}
      }
    },
    "primaryGoal": "signup_succeeded",
    "funnels": [
      {
        "id": "signup",
        "unit": "session",
        "windowMinutes": 30,
        "steps": [
          "page_view",
          "signup_started",
          "signup_succeeded"
        ]
      }
    ]
  }
}
